---
import { APK_URL, RELEASES_URL, REPOSITORY_URL } from "../lib/downloads";
const iosUrl = import.meta.env.PUBLIC_IOS_DOWNLOAD_URL as string | undefined;
---

<div class="install" data-ios-url={iosUrl}>
  <button class="install-cta install-command" type="button" hidden>
    <svg
      class="terminal-icon"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m4 5 6 7-6 7M13 19h7" />
    </svg>
    <code></code>
    <svg
      class="copy-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="8" y="8" width="12" height="12" rx="2" />
      <path d="M16 8V4H4v12h4" />
    </svg>
    <svg
      class="copied-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m5 12 4 4L19 6" />
    </svg>
  </button>
  <a class="install-cta install-download" href={RELEASES_URL}>
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
    </svg>
    <span>View downloads</span>
  </a>
  <p class="install-unavailable" hidden></p>
  <div class="desktop-links" hidden>
    <a
      class="source-link"
      href={REPOSITORY_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        class="source-mark"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z" />
      </svg>
      <span>source code</span>
      <svg
        class="source-arrow"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7M8 7h9v9" />
      </svg>
    </a>
    <p class="mobile-links">
      Also on your phone:
      {iosUrl ? (
        <a href={iosUrl}>iOS</a>
      ) : (
        <span aria-disabled="true" title="iOS download is not available yet">
          iOS
        </span>
      )}
      <span aria-hidden="true">·</span>
      <a href={APK_URL}>Android</a>
    </p>
  </div>
  <p
    class="copy-status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</div>

<script>
  import { detectPlatform, installAction } from "../lib/downloads";
  const root = document.querySelector<HTMLElement>(".install");
  const button = root?.querySelector<HTMLButtonElement>(".install-command");
  const code = button?.querySelector("code");
  const download = root?.querySelector<HTMLAnchorElement>(".install-download");
  const unavailable = root?.querySelector<HTMLElement>(".install-unavailable");
  const links = root?.querySelector<HTMLElement>(".desktop-links");
  const status = root?.querySelector<HTMLElement>(".copy-status");
  const platform = detectPlatform(
    navigator.userAgent,
    navigator.platform,
    navigator.maxTouchPoints,
  );
  const action = installAction(platform, root?.dataset.iosUrl);

  if (button && code && download && unavailable && links && status) {
    links.hidden =
      platform === "android" ||
      platform === "ios" ||
      /Mobile/i.test(navigator.userAgent);
    button.hidden = action.kind !== "copy";
    download.hidden = action.kind !== "download";
    unavailable.hidden = action.kind !== "unavailable";
    if (action.kind === "download") {
      download.href = action.href;
      download.querySelector("span")!.textContent = action.label;
    } else if (action.kind === "unavailable") {
      unavailable.textContent = action.label;
    } else {
      code.textContent = action.command;
      button.setAttribute("aria-label", `Copy command: ${action.command}`);
      button.title = "Copy command";
      let reset: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener("click", async () => {
        clearTimeout(reset);
        button.disabled = true;
        button.classList.remove("is-copied");
        try {
          await navigator.clipboard.writeText(action.command);
          button.classList.add("is-copied");
          status.textContent = "Command copied.";
          reset = setTimeout(() => {
            button.classList.remove("is-copied");
            status.textContent = "";
          }, 2500);
        } catch {
          status.textContent =
            "Couldn’t copy. Select the command to copy it manually.";
        } finally {
          button.disabled = false;
        }
      });
    }
  }
</script>

<style>
  .install {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    gap: 20px;
  }
  [hidden] {
    display: none !important;
  }
  .install-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: min(100%, 640px);
    min-height: 56px;
    padding: 14px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #111;
    color: var(--fg);
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  .install-cta:hover {
    background: #191919;
    border-color: #4b4b4b;
  }
  .install-download {
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
  }
  .install-download:hover {
    background: #dedede;
  }
  .install-command code {
    font:
      14px/1.5 ui-monospace,
      SFMono-Regular,
      Menlo,
      Consolas,
      monospace;
    overflow-wrap: anywhere;
    user-select: text;
    min-width: 0;
  }
  .install-cta svg {
    flex-shrink: 0;
  }
  .terminal-icon,
  .copy-icon {
    color: var(--fg-muted);
  }
  .copied-icon {
    display: none;
  }
  .is-copied .copy-icon {
    display: none;
  }
  .is-copied .copied-icon {
    display: block;
  }
  .desktop-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }
  .source-mark {
    flex-shrink: 0;
  }
  .source-arrow {
    flex-shrink: 0;
    opacity: 0.6;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .source-link:hover .source-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .source-link,
    .source-arrow {
      transition: none;
    }
    .source-link:hover .source-arrow {
      transform: none;
    }
  }
  .mobile-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 7px;
  }
  .mobile-links a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .desktop-links a:hover {
    color: var(--fg);
  }
  .mobile-links [aria-disabled] {
    opacity: 0.55;
  }
  .install-unavailable {
    color: var(--fg-muted);
  }
  .copy-status {
    position: absolute;
    top: 100%;
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 12px;
  }
  @media (max-width: 380px) {
    .install-cta {
      padding: 12px;
      gap: 10px;
    }
    .install-command code {
      font-size: 12px;
    }
  }
</style>
