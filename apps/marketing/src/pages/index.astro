---
// Adapted from T3 Code's centered marketing hero and screenshot frame.
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import InstallCommand from "../components/InstallCommand.astro";
import logo from "../assets/logo.png";
import poster from "../assets/product-poster.jpg";
import { questions } from "../lib/site-content";

const steps = [
  {
    title: "Make a group.",
    description:
      "Choose a computer to host your group. Keep one for your own devices, or share a group with your office.",
  },
  {
    title: "Connect your devices.",
    description:
      "Scan the host’s QR code to join. Use your local network, or connect through Tailscale when you’re away.",
  },
  {
    title: "Send a thing.",
    description:
      "Share a photo, video, file or link to the chat. Open it on another device, save it, or drag it into another app on desktop.",
  },
];
---

<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <Image
        class="hero-logo"
        src={logo}
        alt=""
        width={160}
        height={160}
        densities={[1, 2, 3]}
        format="webp"
        quality={95}
        loading="eager"
      />
      <h1 id="hero-title">
        Send things between
        <br />
        your devices.
      </h1>
      <p class="hero-sub">
        Files, photos, videos and links. Share them in a group chat and pick
        them up on another device.
      </p>
      <InstallCommand />
    </div>
    <div class="container hero-preview">
      <figure class="hero-video-frame">
        <video
          class="hero-video"
          src="/media/send-thing-synced.mp4"
          poster={poster.src}
          width="1920"
          height="836"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          aria-label="Send Thing product demo showing sharing between devices"
        >
          <img
            src={poster.src}
            width="1920"
            height="836"
            alt="Send Thing running on desktop and phone."
          />
        </video>
      </figure>
    </div>
  </section>

  <section
    id="how-it-works"
    class="how-it-works container"
    aria-labelledby="how-title"
  >
    <h2 id="how-title">A chat for your devices.</h2>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
    <p class="host-note">
      Your host stores the group’s messages and files. Keep it awake and
      connected to send or fetch things.
    </p>
  </section>
  <section
    class="questions container"
    aria-labelledby="questions-title"
    id="questions"
  >
    <h2 id="questions-title">Questions</h2>
    {questions.map(({ question, answer }) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </section>
</Layout>

<script>
  // Both recordings are frame-aligned in one asset, so buffering, reloads and
  // native looping cannot advance one device independently of the other.
  const video = document.querySelector<HTMLVideoElement>(".hero-video")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  function updatePlayback() {
    if (reducedMotion.matches || document.hidden) {
      video.pause();
      return;
    }
    if (video.readyState < HTMLMediaElement.HAVE_FUTURE_DATA) return;
    void video.play().catch(() => {
      // Retain the poster if browser policy blocks muted autoplay.
    });
  }
  video.muted = true;
  video.addEventListener("canplay", updatePlayback);
  reducedMotion.addEventListener("change", updatePlayback);
  document.addEventListener("visibilitychange", updatePlayback);
  window.addEventListener("pagehide", () => video.pause());
  window.addEventListener("pageshow", updatePlayback);
  updatePlayback();
</script>

<style>
  .hero {
    padding: 64px 0 0;
  }
  .hero-inner {
    text-align: center;
  }
  .hero-logo {
    display: block;
    margin: 0 auto 16px;
  }
  h1 {
    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.06;
    text-wrap: balance;
  }
  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    max-width: 500px;
    margin: 24px auto 28px;
    text-wrap: pretty;
  }
  .hero-preview {
    margin-top: 64px;
  }
  .hero-video-frame {
    overflow: hidden;
    background: var(--bg);
  }
  .hero-video {
    display: block;
    width: 100%;
    height: auto;
  }
  .how-it-works {
    padding-top: 112px;
    padding-bottom: 96px;
    scroll-margin-top: 96px;
  }
  h2 {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: 40px;
    list-style: none;
  }
  .steps li {
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  h3 {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .steps p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .host-note {
    margin-top: 40px;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .questions {
    padding-bottom: 96px;
  }
  .questions h2 {
    margin-bottom: 32px;
  }
  .questions details {
    border-top: 1px solid var(--border);
    padding: 20px 0;
  }
  .questions summary {
    cursor: pointer;
    font-size: 18px;
  }
  .questions p {
    color: var(--fg-muted);
    max-width: 760px;
    line-height: 1.7;
    margin-top: 16px;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 32px;
    }
    .hero-logo {
      width: 120px;
      height: 120px;
    }
    .hero-preview {
      margin-top: 40px;
    }
    .how-it-works {
      padding-top: 64px;
      padding-bottom: 56px;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 28px;
    }
    .host-note {
      margin-top: 28px;
    }
  }
</style>
