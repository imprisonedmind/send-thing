---
// Adapted from T3 Code's marketing Layout. See THIRD_PARTY_NOTICES.md.
import { getImage, Image } from "astro:assets";
import logo from "../assets/logo.png";
import product from "../assets/product.png";
import dmSansLatinUrl from "../assets/fonts/dm-sans-latin.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Send Thing — Share between your devices",
  description = "Send files, photos, videos and links between your devices in a group chat. Connect over your local network or Tailscale, with a computer you choose as the host.",
} = Astro.props;
const icon = await getImage({
  src: logo,
  width: 64,
  height: 64,
  format: "png",
});
const socialImage = await getImage({
  src: product,
  width: 1200,
  format: "png",
});
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImageUrl = Astro.site
  ? new URL(socialImage.src, Astro.site)
  : undefined;
const imageAlt =
  "Send Thing's menu-bar chat showing a shared photo and a link preview on a desktop.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Send Thing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && (
      <>
        <meta property="og:image" content={socialImageUrl} />
        <meta
          property="og:image:width"
          content={socialImage.attributes.width}
        />
        <meta
          property="og:image:height"
          content={socialImage.attributes.height}
        />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <link
      rel="preload"
      href={dmSansLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" href={icon.src} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-inner">
          <a class="brand" href="/" aria-label="Send Thing home">
            <Image
              src={logo}
              alt=""
              width={40}
              height={40}
              densities={[1, 2]}
              format="webp"
              quality={90}
              loading="lazy"
            />
            <span>send-thing</span>
          </a>
          <span class="copyright">
            &copy; {new Date().getFullYear()} Send Thing
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
