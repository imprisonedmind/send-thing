---
// Adapted from T3 Code's marketing Layout. See THIRD_PARTY_NOTICES.md.
import { getImage, Image } from "astro:assets";
import logo from "../assets/logo.png";
import {
  title as defaultTitle,
  description as defaultDescription,
} from "../lib/site-content";
import {
  structuredData,
  serializeStructuredData,
} from "../lib/structured-data";
import dmSansLatinUrl from "../assets/fonts/dm-sans-latin.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = defaultTitle, description = defaultDescription } = Astro.props;
const icon = await getImage({
  src: logo,
  width: 64,
  height: 64,
  format: "png",
});
if (!Astro.site) throw new Error("Configure a canonical site URL.");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/social/send-thing-og.jpg", Astro.site);
const imageAlt =
  "Send Thing logo with the words: Send things between your devices.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Send Thing" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && (
      <>
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    <link
      rel="preload"
      href={dmSansLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <script
      type="application/ld+json"
      set:html={serializeStructuredData(
        structuredData(canonicalUrl, title, description, socialImageUrl),
      )}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-inner">
          <a class="brand" href="/" aria-label="Send Thing home">
            <Image
              src={logo}
              alt=""
              width={40}
              height={40}
              densities={[1, 2]}
              format="webp"
              quality={90}
              loading="lazy"
            />
            <span>send-thing</span>
          </a>
          <span class="copyright">
            &copy; {new Date().getFullYear()} Send Thing
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
